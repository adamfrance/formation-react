# Copier en .env pour changer la configuration (le fichier .env n'est jamais committé)
# Les secrets se génèrent, ils ne s'inventent pas : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sans eux en développement, l'API tire des secrets au hasard à chaque démarrage ; en production, elle refuse de démarrer.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Port et adresse publique (utilisée dans les adresses des images)
PORT=4000
PUBLIC_URL=http://localhost:4000

# Origines autorisées à appeler l'API depuis un navigateur (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173,http://localhost:3000

# Limite de débit, comme DummyJSON : 100 requêtes par 10 secondes et par adresse IP
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=10000
